#!/bin/bash
# ==============================================================================
# AI COMMAND CENTER (acc) - TRUE ZERO-EFFORT ORCHESTRATOR
# ==============================================================================

PROJECT_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
CORE_DIR="$PROJECT_ROOT/common"
RUN_DIR="$PROJECT_ROOT/data/run"; mkdir -p "$RUN_DIR"
VENV_DIR="$PROJECT_ROOT/.venv"

PROVISIONER="bash $CORE_DIR/provisioner.sh"
HWT="bash $CORE_DIR/hwt.sh"
DASH_PID_FILE="$RUN_DIR/dash.pid"; LOCK_FILE="$RUN_DIR/acc.lock"

log() { echo -e "[\033[1;34macc\033[0m] $1"; }
error() { echo -e "[\033[1;31merror\033[0m] $1"; }

ensure_system_deps() {
    log "Auditing system dependencies..."
    local missing=()
    for cmd in docker jq curl; do
        if ! command -v $cmd &> /dev/null; then missing+=("$cmd"); fi
    done

    if [ ${#missing[@]} -gt 0 ]; then
        log "Missing tools: [${missing[*]}]. Attempting auto-install..."
        if [[ "$OSTYPE" == "linux-gnu"* ]]; then
            if command -v apt-get &> /dev/null; then
                sudo apt-get update -qq && sudo apt-get install -y docker.io jq curl
            fi
        elif [[ "$OSTYPE" == "darwin"* ]]; then
            if command -v brew &> /dev/null; then
                brew install jq curl
                log "Please install Docker Desktop for Mac: https://www.docker.com/products/docker-desktop"
            fi
        else
            error "Automatic installation not supported on $OSTYPE. Please install manually: [${missing[*]}]"
            exit 1
        fi
    fi
}

ensure_python_env() {
    if [ ! -f "$PROJECT_ROOT/requirements.txt" ]; then
        log "[SKIP] requirements.txt not found. Skipping local Python env setup."
        return
    fi
    if [ ! -d "$VENV_DIR" ]; then
        log "Creating isolated Python environment (.venv)..."
        python3 -m venv "$VENV_DIR" || { log "Failed to create venv. Ensure 'python3-venv' is installed."; return; }
    fi

    source "$VENV_DIR/bin/activate"
    log "Syncing Python dependencies..."
    pip install -q --upgrade pip
    pip install -q -r "$PROJECT_ROOT/requirements.txt"
}

setup_env() {
    ensure_system_deps
    ensure_python_env

    mkdir -p "$PROJECT_ROOT/logs" "$PROJECT_ROOT/.cache" "$PROJECT_ROOT/registry" "$PROJECT_ROOT/data/backups" "$PROJECT_ROOT/config"

    if [ ! -f "$PROJECT_ROOT/config/keystore.p12" ]; then
        log "Generating secure local identity..."
        if command -v keytool &> /dev/null; then
            keytool -genkeypair -alias acc -keyalg RSA -keysize 2048 -storetype PKCS12 \
                -keystore "$PROJECT_ROOT/config/keystore.p12" -validity 365 \
                -storepass password -keypass password \
                -dname "CN=localhost, OU=acc, O=intellibitz, L=Unknown, ST=Unknown, C=Unknown" > /dev/null 2>&1
        else
            log "[SKIP] 'keytool' not found. Skipping keystore generation."
        fi
    fi

    # Load .env if exists
    if [ -f "$PROJECT_ROOT/.env" ]; then
        set -a; source "$PROJECT_ROOT/.env"; set +a
    fi

    if [ ! -f "$PROJECT_ROOT/config/fleet.json" ]; then
        log "Initializing default fleet..."
        echo '{"models": [{"name": "phi3", "repo": "microsoft/Phi-3-mini-4k-instruct-gguf", "filePattern": "*Q4_K_M.gguf", "tier": "FAST", "quant": "Q4_K_M", "isPrivate": false}]}' > "$PROJECT_ROOT/config/fleet.json"
    fi

    if [ -f "$PROJECT_ROOT/common/hwt.sh" ]; then
        $HWT sync --auto; $HWT tune
    else
        log "[SKIP] common/hwt.sh not found. Skipping hardware tuning."
    fi
}

cleanup_dash() {
    [ -f "$DASH_PID_FILE" ] && { pid=$(cat "$DASH_PID_FILE"); kill "$pid" 2>/dev/null; sleep 1; rm "$DASH_PID_FILE"; }
    pkill -f "tooling/tui_dashboard.py" 2>/dev/null
}

open_url() {
    if command -v xdg-open &> /dev/null; then xdg-open "$1" &> /dev/null;
    elif command -v open &> /dev/null; then open "$1" &> /dev/null;
    else log "Dashboard ready at: $1"; fi
}

smart_start() {
    if curl -sk http://localhost:8333/health > /dev/null; then
        log "Acc Cockpit is active."
        open_url "http://localhost:8333"
        return
    fi

    if [ ! -f "$PROJECT_ROOT/docker-compose.yml" ]; then
        log "Fetching deployment configuration..."
        curl -sSL "https://raw.githubusercontent.com/intellibitz/acc/main/docker-compose.yml" -o "$PROJECT_ROOT/docker-compose.yml"
    fi

    if command -v docker-compose &> /dev/null || docker compose version &> /dev/null; then
        log "Launching via Docker (Zero-Effort Integrity)..."
        docker compose up -d
    else
        log "Docker not found. Falling back to local host execution..."
        if [ ! -f "$PROJECT_ROOT/requirements.txt" ]; then
            log "[ERROR] Docker missing and requirements.txt not found. Cannot launch."
            exit 1
        fi
        ensure_system_deps
        ensure_python_env
        cleanup_dash
        nohup bash "$PROJECT_ROOT/acc" gui > /dev/null 2>&1 &
    fi

    (
        timeout=60
        while [ $timeout -gt 0 ]; do
            if curl -sk http://localhost:8333/health > /dev/null; then
                log "[SUCCESS] Cockpit online."
                open_url "http://localhost:8333"
                exit 0
            fi
            sleep 2
            ((timeout--))
        done
        error "Manager failed to start. Check docker logs or logs/gateway.log"
    ) &
}

case "$1" in
    setup) setup_env ;;
    up)
        if [ -n "$2" ]; then
            curl -skX POST "https://localhost:8333/provisioning/up?model=$2"
        else
            curl -skX POST https://localhost:8333/provisioning/up
        fi
        ;;
    dash) source "$VENV_DIR/bin/activate"; python3 "$PROJECT_ROOT/tooling/tui_dashboard.py" ;;
    status) [ -f "$PROJECT_ROOT/common/hwt.sh" ] && $HWT status || log "[SKIP] hwt.sh not found." ;;
    sync) [ -f "$PROJECT_ROOT/common/hwt.sh" ] && $HWT sync || log "[SKIP] hwt.sh not found." ;;
    tune-hw) [ -f "$PROJECT_ROOT/common/hwt.sh" ] && $HWT tune || log "[SKIP] hwt.sh not found." ;;
    maint)
        case "$2" in
            kill) [ -f "./gradlew" ] && ./gradlew --stop; pkill -f "cc.thevar.acc" ;;
            prune) [ -f "$PROJECT_ROOT/common/provisioner.sh" ] && $PROVISIONER prune || log "[SKIP] provisioner.sh not found." ;;
            *) echo "Usage: ./acc maint [kill|prune]" ;;
        esac
        ;;
    gui)
        export NODE_OPTIONS="--no-deprecation"
        [ -d "$VENV_DIR" ] && source "$VENV_DIR/bin/activate"

        # Check for pre-built JAR (Installed Mode)
        if [ -f "$PROJECT_ROOT/bin/acc-gateway.jar" ]; then
            log "Starting pre-built cockpit..."
            java -jar "$PROJECT_ROOT/bin/acc-gateway.jar" > "$PROJECT_ROOT/logs/gateway.log" 2>&1
        elif [ -f "$PROJECT_ROOT/gradlew" ]; then
            # Source Mode: Start the build in background if missing
            if [ ! -d "frontend/web/build/dist/wasmJs/productionExecutable" ]; then
                log "Triggering background frontend build..."
                nohup ./gradlew :frontend:web:wasmJsBrowserDistribution --quiet > logs/build.log 2>&1 &
            fi
            ./gradlew :gateway:run --no-daemon > "$PROJECT_ROOT/logs/gateway.log" 2>&1
        else
            error "No executable found. Please use Docker or run in Source Mode with gradlew."
            exit 1
        fi
        ;;
    stop)
        cleanup_dash
        [ -f "$PROJECT_ROOT/common/hwt.sh" ] && $HWT stop
        pkill -f "cc.thevar.acc"
        log "System stopped."
        ;;
    uninstall)
        if [ -d "$PROJECT_ROOT/.git" ]; then
            error "Uninstall blocked: This appears to be a Creator/Source directory (found .git)."
            error "If you want to delete this repository, please use 'rm -rf $PROJECT_ROOT' manually."
            exit 1
        fi

        FORCE=false
        if [[ "$2" == "--force" ]]; then FORCE=true; fi

        if [ "$FORCE" = false ]; then
            log "WARNING: This will completely remove Acc and all AI models."
            read -p "[PROMPT] Are you sure? (y/N) " -n 1 -r </dev/tty
            echo
            [[ ! $REPLY =~ ^[Yy]$ ]] && { log "Uninstallation aborted."; exit 0; }
        fi

        log "Stopping infrastructure..."
        [ -f "$PROJECT_ROOT/docker-compose.yml" ] && docker compose down -v 2>/dev/null
        pkill -f "cc.thevar.acc" || true

        log "Reclaiming disk space..."
        rm -rf "$PROJECT_ROOT"
        rm -f "$HOME/.local/bin/acc"

        if [ -f "/etc/sysctl.d/99-llm-hw.conf" ]; then
            log "Removing hardware tweaks..."
            sudo rm "/etc/sysctl.d/99-llm-hw.conf" 2>/dev/null
            sudo sysctl --system >/dev/null 2>&1 || true
        fi
        log "\033[1;32mSUCCESS!\033[0m Acc has been uninstalled."
        ;;
    add)
        # Usage: acc add "provider|name|repo|filePattern|tier|quant|superpower" [--private]
        shift
        ENTRY="$1"; shift
        IS_PRIVATE="false"
        while [[ "$#" -gt 0 ]]; do
            case $1 in
                --private) IS_PRIVATE="true" ;;
            esac
            shift
        done

        IFS='|' read -r provider name repo pattern tier quant superpower <<< "$ENTRY"
        [ -z "$name" ] && { error "Invalid entry. Format: 'provider|name|repo|filePattern|tier|quant|superpower'"; exit 1; }

        log "Adding model '$name' (Engine: $provider) to fleet..."
        # We need a way to call FleetManager or use jq to update fleet.json
        FLEET_JSON="$PROJECT_ROOT/config/fleet.json"
        if [ ! -f "$FLEET_JSON" ]; then echo '{"models":[]}' > "$FLEET_JSON"; fi

        tmp=$(mktemp)
        jq --arg p "$provider" --arg n "$name" --arg r "$repo" --arg pat "$pattern" \
           --arg t "$tier" --arg q "$quant" --arg s "$superpower" --arg priv "$IS_PRIVATE" \
           '.models += [{"provider": $p, "name": $n, "repo": $r, "filePattern": $pat, "tier": $t, "quant": $q, "superpower": $s, "isPrivate": ($priv == "true")}]' \
           "$FLEET_JSON" > "$tmp" && mv "$tmp" "$FLEET_JSON"

        log "[SUCCESS] Model added. Restarting bridge..."
        pkill -f "brain/system_bridge.py" || true
        ;;
    ""|help) [[ -z "$1" ]] && smart_start || echo "Usage: ./acc [setup|up|dash|status|sync|tune-hw|maint|stop|uninstall|add]" ;;
    *) echo "Unknown: $1"; exit 1 ;;
esac
